# Maintainer: Black Cyan <blackcyan07@outlook.com>
pkgname=collins-dictionary-bin
pkgver=1.0.0
pkgrel=1
pkgdesc="Collins Dictionary desktop client (bundled JetBrains Runtime)"
arch=('x86_64')
url="https://github.com/Black-Cyan/collins-dictionary"
license=('GPL-3.0-or-later')
depends=(
  'alsa-lib'
  'bash'
  'fontconfig'
  'freetype2'
  'libjpeg-turbo'
  # paplay (PipeWire ships a Pulse-compatible one) streams pronunciation audio.
  'libpulse'
  'libx11'
  'libxcursor'
  'libxext'
  'libxfixes'
  'libxi'
  'libxrandr'
  'libxtst'
  'libxxf86vm'
  'zlib'
)
options=(!strip !debug)
_tarname="collins-dictionary-${pkgver}-linux-x64"
source_x86_64=(
  "https://github.com/Black-Cyan/collins-dictionary/releases/download/v${pkgver}/${_tarname}.tar.gz"
  "collins-dictionary.desktop"
  "collins-dictionary.png"
  "LICENSE"
)
sha256sums_x86_64=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -dm755 "$pkgdir/opt/collins-dictionary"
  cp -a "$srcdir/$_tarname/." "$pkgdir/opt/collins-dictionary/"

  install -dm755 "$pkgdir/usr/bin"
  ln -s /opt/collins-dictionary/bin/collins-dictionary \
    "$pkgdir/usr/bin/collins-dictionary"

  install -Dm644 "$srcdir/collins-dictionary.desktop" \
    "$pkgdir/usr/share/applications/collins-dictionary.desktop"
  install -Dm644 "$srcdir/collins-dictionary.png" \
    "$pkgdir/usr/share/pixmaps/collins-dictionary.png"

  install -Dm644 "$srcdir/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
